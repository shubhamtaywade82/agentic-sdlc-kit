{
  "$comment": [
    "Copy to your project root as .mcp.json and adjust. Claude Code, Cursor,",
    "Windsurf, VS Code Copilot agent mode, and Gemini CLI all read this format",
    "(modelcontextprotocol.io). Remove servers you do not want. The 'sdlc'",
    "server is the kit's own: build it first with",
    "  cd .ai/mcp/server && npm install && npm run build",
    "Guard tokens like GITHUB_PERSONAL_ACCESS_TOKEN in your environment, never here."
  ],
  "mcpServers": {
    "sdlc": {
      "command": "node",
      "args": [".ai/mcp/server/build/index.js"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
