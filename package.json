{
  "name": "agentic-sdlc-kit",
  "version": "0.9.1",
  "private": true,
  "description": "Runtime-independent Agentic SDLC Kit. M0+M1 foundation: contracts, core, cli, testing, and the Claude Code adapter boundary. Also hosts the agentic-mods Claude Code marketplace scaffold (mods/, workflows/, presets, marketplace tooling).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@12.21.0",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "fixtures/*",
    "mods/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./plugins/*\" --filter \"./mods/*\" build",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./plugins/*\" --filter \"./mods/*\" typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=4 --filter \"./packages/*\" --filter \"./plugins/*\" --filter \"./mods/*\" test",
    "test:contract": "pnpm -r --workspace-concurrency=4 --filter \"./packages/*\" --filter \"./plugins/*\" test:contract",
    "test:tooling": "node --import tsx --test scripts/release-preflight.test.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "milestones:check": "tsx scripts/milestone-status.ts --check",
    "milestones:write": "tsx scripts/milestone-status.ts --write",
    "marketplace:generate": "node tooling/generate-marketplace/generate.js",
    "marketplace:validate": "node tooling/generate-marketplace/validate.js",
    "verify": "pnpm run check:architecture && pnpm run milestones:check && pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:tooling",
    "clean": "pnpm -r --filter \"./packages/*\" --filter \"./plugins/*\" --filter \"./mods/*\" exec -- rm -rf dist *.tsbuildinfo",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "kit": "pnpm --filter @agentic-sdlc-kit/cli start"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.0.0"
  }
}
