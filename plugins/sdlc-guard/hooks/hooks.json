{
  "description": "sdlc-guard: gates destructive Bash commands before they run (PreToolUse). Requires Claude Code >= 2.1.295 for onFailure.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/guard.js\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
