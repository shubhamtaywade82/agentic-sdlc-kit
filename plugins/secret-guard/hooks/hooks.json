{
  "description": "secret-guard: refuses file writes and git commits that add secrets (PreToolUse). Requires Claude Code >= 2.1.295 for onFailure.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/guard.js\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
